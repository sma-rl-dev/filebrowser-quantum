cmd_verify() {
    echo "==> Verifying running state..."

    curl -fsS "http://localhost:${PORT}/health" | grep -q '"ok"' \
        || { echo "ERROR: /health is not ok."; exit 1; }

    local token
    token="$(api_login)" || { echo "ERROR: login as ${ADMIN_USER} failed."; exit 1; }
    [[ -n "${token}" ]] || { echo "ERROR: login returned an empty token."; exit 1; }

    # The SPA must come from internal/web/dist. A blank embed build yields an
    # index without the built asset files.
    local index_html asset
    index_html="$(curl -fsS "http://localhost:${PORT}/")" \
        || { echo "ERROR: UI index not reachable."; exit 1; }
    echo "${index_html}" | grep -q '<div id="app"' \
        || { echo "ERROR: UI index has no app mount point."; exit 1; }
    asset="$(echo "${index_html}" | grep -oE '/public/static/[^"]+\.(js|css)' | head -1)"
    [[ -n "${asset}" ]] || { echo "ERROR: UI index references no built assets."; exit 1; }
    curl -fsS -o /dev/null "http://localhost:${PORT}${asset}" \
        || { echo "ERROR: UI asset ${asset} is not served."; exit 1; }

    local me
    me="$(curl -fsS -H "Authorization: Bearer ${token}" \
        "http://localhost:${PORT}/api/users?username=self")" \
        || { echo "ERROR: /api/users is not reachable with the login token."; exit 1; }
    echo "${me}" | jq -e --arg u "${ADMIN_USER}" '.username == $u and .permissions.admin == true' >/dev/null \
        || { echo "ERROR: logged-in user is not the admin."; exit 1; }

    echo "==> Waiting for the seeded listing (indexing is asynchronous)..."
    local listing i ok=""
    local want_folders="01-Projects 02-Finance 03-Operations 04-Marketing Archive"
    local want_files="README.md office-floor-plan.png team-roster.csv"
    for i in $(seq 1 30); do
        listing="$(curl -fsS -H "Authorization: Bearer ${token}" \
            "http://localhost:${PORT}/api/resources?path=/&source=files" 2>/dev/null || true)"
        if [[ -n "${listing}" ]] \
            && [[ "$(echo "${listing}" | jq -r '[.folders[]?.name]|sort|join(" ")')" == "${want_folders}" ]] \
            && [[ "$(echo "${listing}" | jq -r '[.files[]?.name]|sort|join(" ")')" == "${want_files}" ]]; then
            ok=1
            break
        fi
        sleep 2
    done
    if [[ -z "${ok}" ]]; then
        echo "ERROR: the seeded root listing is not visible."
        echo "       Expected folders: ${want_folders}"
        echo "       Expected files:   ${want_files}"
        echo "       Run 'seed' first and check the container logs."
        exit 1
    fi

    local projects
    projects="$(curl -fsS -H "Authorization: Bearer ${token}" \
        "http://localhost:${PORT}/api/resources?path=/01-Projects&source=files")"
    [[ "$(echo "${projects}" | jq -r '[.folders[]?.name]|sort|join(" ")')" == "Atlas-Redesign Beacon-Mobile-App Cedar-Portal-Migration" ]] \
        || { echo "ERROR: 01-Projects folders are not the seeded projects."; exit 1; }
    [[ "$(echo "${projects}" | jq -r '[.files[]?.name]|sort|join(" ")')" == "Q2 Client Kickoff Notes.md" ]] \
        || { echo "ERROR: 01-Projects file list is not the seeded one."; exit 1; }

    local counts
    counts="$(docker exec "${CONTAINER_NAME}" sh -c \
        'printf "%s %s" "$(find /data/files -type f | wc -l)" "$(find /data/files -mindepth 1 -type d | wc -l)"')"
    [[ "${counts}" == "24 18" ]] \
        || { echo "ERROR: expected 24 files / 18 folders under /data/files, got '${counts}'."; exit 1; }

    local users
    users="$(curl -fsS -H "Authorization: Bearer ${token}" "http://localhost:${PORT}/api/users" \
        | jq -r '[.[].username]|sort|join(" ")')"
    [[ "${users}" == "admin ava.chen mila.rossi noah.patel" ]] \
        || { echo "ERROR: seeded users missing, got '${users}'."; exit 1; }

    # The seeded standard-user credentials must actually log in.
    curl -fsS -o /dev/null -X POST \
        "http://localhost:${PORT}/api/auth/login?username=ava.chen" \
        -H "X-Password: tester-env-user" \
        || { echo "ERROR: seeded user ava.chen cannot log in."; exit 1; }

    local shares
    shares="$(curl -fsS -H "Authorization: Bearer ${token}" "http://localhost:${PORT}/api/share/list")"
    [[ "$(echo "${shares}" | jq 'length')" == "1" ]] \
        || { echo "ERROR: expected exactly one seeded share, got '${shares}'."; exit 1; }
    echo "${shares}" | jq -e --arg t "${SEED_SHARE_TITLE}" --arg p "${SEED_SHARE_PATH}" \
        '.[0].title == $t and .[0].path == $p' >/dev/null \
        || { echo "ERROR: the seeded share is not the expected title/path."; exit 1; }

    # Informational: stable hash of the seeded tree (relative path, mtime, content).
    local fingerprint
    fingerprint="$(docker exec "${CONTAINER_NAME}" sh -c \
        'cd /data/files && find . -type f | sort | while IFS= read -r f; do printf "%s %s %s\n" "$f" "$(stat -c %Y "$f")" "$(sha256sum <"$f")"; done | sha256sum' \
        | cut -d" " -f1)"

    echo "==> Verification complete: health, login, SPA dist assets, admin user,"
    echo "    seed tree (24 files / 18 folders), users and share."
    echo "==> seed fingerprint (name+mtime+content): ${fingerprint}"
}

cmd_reset_inner() {
    docker stop "${CONTAINER_NAME}" >/dev/null 2>&1 || true
    docker rm "${CONTAINER_NAME}" >/dev/null 2>&1 || true
    docker volume rm "${DATA_VOLUME}" >/dev/null 2>&1 || true
}

cmd_reset() {
    echo "==> Resetting environment (container + sqlite/files volume: clean slate)..."
    cmd_reset_inner
    echo "==> Reset complete. Run 'deploy' to start fresh."
}

cmd_stop() {
    echo "==> Stopping container (data volume preserved)..."
    docker stop "${CONTAINER_NAME}" >/dev/null 2>&1 || echo "==> Container not running."
    echo "==> Stopped."
}

cmd_logs() {
    docker logs -f "${CONTAINER_NAME}" 2>/dev/null || echo "Container not running."
}

cmd_status() {
    if running; then
        echo "Status: RUNNING"
        echo "URL: http://localhost:${PORT}"
        echo "Browser origin: ${TESTER_ENV_BROWSER_ORIGIN:-http://localhost:${PORT}}"
        echo "Container: ${CONTAINER_NAME}"
        echo "Image: $(docker inspect -f '{{.Config.Image}}' "${CONTAINER_NAME}")"
        echo "Data volume: ${DATA_VOLUME} (sqlite: /data/database.sqlite, files: /data/files)"
    else
        echo "Status: NOT RUNNING"
        echo "Container: ${CONTAINER_NAME}"
    fi
}

