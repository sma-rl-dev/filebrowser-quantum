  deploy    Build image from source, start the app (fresh /data volume)
  seed      Install the shared-drive seed: files, users and one share
  verify    Assert health, login, SPA assets, admin, seed tree, users, share
  reset     Stop/remove container and /data volume (keeps image)
  stop      Stop container (keeps /data volume)
  logs      Tail the app container logs
  status    Show container status, URL and volume
  help      Show this help message

Options:
  --run-id <id>     Isolate container/volume names for parallel runs.
                    Default: default (or \$RUN_ID)
  --port <port>     Host port mapped to container port 80.
                    Default: 18078 (or \$PORT)

Env:
  ADMIN_USER (default admin), ADMIN_PASSWORD (default tester-env-admin)
  IMAGE_TAG (set by scripts/rl-env; manual runs use :dev)
  BASE_URL / TESTER_ENV_BROWSER_ORIGIN only affect the printed URL.

Credentials: ${ADMIN_USER} / ${ADMIN_PASSWORD}
Seed users: ava.chen, noah.patel, mila.rossi / tester-env-user (standard users)
Seed share: '${SEED_SHARE_TITLE}' for ${SEED_SHARE_PATH}
EOF
}

main() {
    local cmd="${1:-help}"
    shift || true

    while [[ $# -gt 0 ]]; do
        case "${1}" in
            --run-id) RUN_ID="${2:?--run-id requires a value}"; shift 2 ;;
            --port) PORT="${2:?--port requires a value}"; shift 2 ;;
            --help|-h) cmd_help; exit 0 ;;
            *) echo "Error: unknown argument '${1}'"; cmd_help; exit 1 ;;
        esac
    done

    BASE_URL="${BASE_URL:-http://localhost:${PORT}}"
    refresh_names

    case "${cmd}" in
        deploy) cmd_deploy ;;
        seed) cmd_seed ;;
        verify) cmd_verify ;;
        reset) cmd_reset ;;
        stop) cmd_stop ;;
        logs) cmd_logs ;;
        status) cmd_status ;;
        help|--help|-h) cmd_help ;;
        *) echo "Error: unknown command '${cmd}'"; cmd_help; exit 1 ;;
    esac
}

main "$@"
