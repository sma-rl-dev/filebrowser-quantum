#!/usr/bin/env bash
set -euo pipefail

# filebrowser-quantum - Tester Environment CLI
# Usage: ./tester-env <command> [--run-id <id>] [--port <port>]
# Commands: deploy, seed, verify, reset, stop, logs, status, help
#
# Builds from editable source via Dockerfile.tester-env in this directory
# (ffmpeg stage -> golang:1.27.4-alpine CGO mupdf -> node:jod-slim vite ->
# alpine:3.23 runtime), never from a prebuilt image. The deterministic config
# is tester-env.yaml, baked into the image at /home/filebrowser/config/config.yaml.
#
# Runtime: single container, sqlite + cache + files under /data (named volume).
# Reset = remove the container and the volume, so reset -> deploy -> seed is the
# reproducible path. Seed installs a business shared-drive tree (fixed names,
# sizes and mtimes), three standard users via the app CLI and one share via the
# API, replacing all mutable state so a re-seed returns the same visible data.
# Previews (ffmpeg/mupdf) stay enabled; the analytics build tag is dropped and
# server.disableUpdateCheck is set, so the container makes no telemetry or
# GitHub tag calls.

RUN_ID="${RUN_ID:-default}"
PORT="${PORT:-18078}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TESTER_ENV_PROJECT="${TESTER_ENV_PROJECT:-tester-env}"
TESTER_ENV_APP="${TESTER_ENV_APP:-filebrowser-quantum}"
TESTER_ENV_SCENARIO="${TESTER_ENV_SCENARIO:-manual}"
ADMIN_USER="${ADMIN_USER:-admin}"
ADMIN_PASSWORD="${ADMIN_PASSWORD:-tester-env-admin}"
# Resolved after flag parsing so --port is reflected; operator env wins.
BASE_URL="${BASE_URL:-${TESTER_ENV_BROWSER_ORIGIN:-}}"

refresh_names() {
    local suffix=""
    if [[ "${RUN_ID}" != "default" ]]; then
        suffix="-${RUN_ID}"
    fi

    CONTAINER_NAME="tester-env-filebrowser-quantum${suffix}"
    DATA_VOLUME="filebrowser-quantum-data${suffix}"
    # IMAGE_TAG set by scripts/rl-env to a content-addressed tag so identical
    # (baseline, patch-set) combos share an image. Manual invocations get :dev.
    IMAGE_NAME="${IMAGE_TAG:-tester-env-filebrowser-quantum:dev}"
}

labels() {
    echo --label "tester-env.project=${TESTER_ENV_PROJECT}"
    echo --label "tester-env.app=${TESTER_ENV_APP}"
    echo --label "tester-env.scenario=${TESTER_ENV_SCENARIO}"
}

running() {
    docker ps --filter "name=${CONTAINER_NAME}" --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"
}

api_login() {
    # Login is POST /api/auth/login?username=<user> with the URL-encoded
    # password in the X-Password header; the response body is the raw JWT.
    local encoded
    encoded="$(printf '%s' "${ADMIN_PASSWORD}" | jq -sRr @uri)"
    curl -fsS -X POST \
        "http://localhost:${PORT}/api/auth/login?username=${ADMIN_USER}" \
        -H "X-Password: ${encoded}"
}

cmd_wait_ready() {
    local i
    for i in $(seq 1 60); do
        if curl -fsS "http://localhost:${PORT}/health" 2>/dev/null | grep -q '"ok"'; then
            if [[ -n "$(api_login 2>/dev/null)" ]]; then
                return 0
            fi
        fi
        if ! running; then
            echo "ERROR: container exited during startup."
            docker logs "${CONTAINER_NAME}" 2>&1 | tail -40 || true
            exit 1
        fi
        sleep 2
    done

    echo "ERROR: FileBrowser Quantum did not become ready in time."
    docker logs "${CONTAINER_NAME}" 2>&1 | tail -40 || true
    exit 1
}

cmd_deploy() {
    echo "==> Resetting any previous run (${RUN_ID})..."
    cmd_reset_inner

    echo "==> Building image from source (${IMAGE_NAME})..."
    docker build \
        $(labels) \
        -f "${SCRIPT_DIR}/Dockerfile.tester-env" \
        -t "${IMAGE_NAME}" \
        "${SCRIPT_DIR}"

    echo "==> Creating volume ${DATA_VOLUME} (reuse if present)..."
    docker volume inspect "${DATA_VOLUME}" >/dev/null 2>&1 || docker volume create \
        $(labels) "${DATA_VOLUME}" >/dev/null

    echo "==> Starting FileBrowser Quantum on port ${PORT}..."
    docker run -d --name "${CONTAINER_NAME}" \
        $(labels) \
        -p "${PORT}:80" \
        -v "${DATA_VOLUME}:/data" \
        -e FILEBROWSER_ADMIN_PASSWORD="${ADMIN_PASSWORD}" \
        "${IMAGE_NAME}" >/dev/null

    echo "==> Waiting for FileBrowser Quantum (health + login)..."
    cmd_wait_ready

    echo "==> Deployment complete. App running at ${BASE_URL}"
    echo "==> Login: ${ADMIN_USER} / ${ADMIN_PASSWORD}"
}

