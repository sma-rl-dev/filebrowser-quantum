cmd_seed() {
    docker inspect "${CONTAINER_NAME}" >/dev/null 2>&1 \
        || { echo "ERROR: container ${CONTAINER_NAME} does not exist. Run 'deploy' first."; exit 1; }

    # Stop the server first: the sqlite database, the index and the file tree
    # are all rewritten below, and a running writer would race the CLI.
    if running; then
        echo "==> Stopping the app to install the seed data set..."
        docker stop "${CONTAINER_NAME}" >/dev/null
    fi

    echo "==> Writing the shared-drive tree, fixed mtimes and seed users..."
    docker run --rm -i \
        $(labels) \
        --user 1000:1000 \
        -v "${DATA_VOLUME}:/data" \
        --entrypoint sh \
        "${IMAGE_NAME}" -s <<'SEED' || { echo "ERROR: seeding failed."; exit 1; }
set -e
